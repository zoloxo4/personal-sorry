# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated email addresses allowed into /admin
ADMIN_EMAILS=you@example.com

# Optional: customize the text shown on the page
NEXT_PUBLIC_LOVED_ONE_NAME=meri jaan
NEXT_PUBLIC_YOUR_NAME=tumhara pagal
